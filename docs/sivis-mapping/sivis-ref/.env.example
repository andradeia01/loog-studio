# App
APP_URL=http://localhost:8080
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Auth (Zaia -> Hub)
INTERNAL_API_KEY=change-me-generate-with-openssl-rand-hex-32
ZAIA_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://loog:loog@localhost:5432/loog_hub
REDIS_URL=redis://localhost:6379

# Providers (mock in dev)
MOCK_MODE=true

VEHICLE_API_PROVIDER=mock
VEHICLE_API_BASE_URL=
VEHICLE_API_KEY=

# External plate lookup. "wdapi2" (pay-per-use) | "apibrasil" | "mock" | "none".
PLATE_LOOKUP_PROVIDER=none
APIBRASIL_BASE_URL=https://gateway.apibrasil.io/api/v2
APIBRASIL_DEVICE_TOKEN=
APIBRASIL_BEARER_TOKEN=
WDAPI2_BASE_URL=https://wdapi2.com.br
WDAPI2_TOKEN=
# placas.app.br — JWT-based (email+password auto-login OR pre-obtained token)
PLACAS_APP_BR_BASE_URL=https://placas.app.br/api/v1
PLACAS_APP_BR_EMAIL=
PLACAS_APP_BR_PASSWORD=
PLACAS_APP_BR_TOKEN=

# placafipe.com.br — token via POST body; also returns FIPE code + valor in the
# same call (best-match). Docs: https://doc.placafipe.com.br
PLACAFIPE_BASE_URL=https://api.placafipe.com.br
PLACAFIPE_TOKEN=

FIPE_API_PROVIDER=mock
FIPE_API_BASE_URL=
FIPE_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# WhatsApp Business Platform (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=

# Vision / LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required ONLY when ANTHROPIC_API_KEY is an org-scoped key (not workspace-scoped).
# Find it at console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Storage (S3-compatible)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Privacy
DOCUMENT_RETENTION_MINUTES=0

# SDR MVP (WhatsApp via Baileys)
SDR_ENABLED=false
SDR_WHATSAPP_NUMBER_LABEL=loog-main
SDR_DATA_DIR=./data
SDR_MODEL_DEFAULT=claude-haiku-4-5-20251001
SDR_MODEL_HARD=claude-sonnet-5-5
SDR_MAX_AGENT_ITERATIONS=5
SDR_HUB_BASE_URL=http://localhost:8080

# Sivisweb (Quote provider) - PHASE 13
QUOTE_PROVIDER=none
SIVISWEB_BASE_URL=https://portal.sivisweb.com.br
SIVISWEB_STORE_ID=028
SIVISWEB_USERNAME=
SIVISWEB_PASSWORD=
SIVISWEB_SESSION_TTL_MINUTES=30
# Id de consultor / sessão do Sivisweb usado no URL do PDF (imprimirRapida?id=...)
SIVISWEB_CONSULTOR_ID=10
